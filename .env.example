# ============================================================
# LF ERP Backend v2.0.0 - Variáveis de ambiente necessárias
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# Banco de dados (Neon PostgreSQL)
# Obtenha em: https://neon.tech → seu projeto → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Segredo JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua-chave-secreta-jwt-aqui-minimo-32-caracteres

# CORS — URL do frontend (separar múltiplos por vírgula, sem barra no final)
ALLOWED_ORIGINS=https://lf-erp-frontend.vercel.app

# Porta do servidor (Render define automaticamente, não altere em produção)
PORT=3001

# Token para o endpoint /reset-dados (obrigatório para usar o endpoint)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure também no Render → Environment → RESET_SECRET
RESET_SECRET=sua-chave-secreta-reset-aqui

# Claude AI — Resumo executivo IA (C5.2)
# Obtenha em: https://console.anthropic.com → API Keys
# Configure também no Render → Environment → ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# Sentry — Monitoramento de erros em produção (C5.3)
# Obtenha em: sentry.io → Criar projeto → Node.js → DSN
# Configure também no Render → Environment → SENTRY_DSN
# Opcional: backend funciona sem esta chave, mas erros não serão capturados
SENTRY_DSN=https://...@sentry.io/...

# Token de validação dos webhooks Asaas (boleto/PIX) — OBRIGATÓRIO em produção
# Sem esta chave, os webhooks de pagamento são REJEITADOS (fail-closed por segurança)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure também no Render → Environment → ASAAS_WEBHOOK_TOKEN
# E no painel do Asaas → Configurações → Webhooks → cabeçalho "asaas-access-token"
ASAAS_WEBHOOK_TOKEN=sua-chave-secreta-webhook-asaas-aqui

# Cloudinary — Upload de imagens de produtos (imagens.routes.js)
# Obtenha em: cloudinary.com → Dashboard → API Keys
# OBRIGATÓRIO para o módulo de imagens funcionar
CLOUDINARY_CLOUD_NAME=meu-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=sua-chave-secreta-cloudinary-aqui

# Mercado Livre — Integração OAuth2 (marketplace.routes.js)
# MARKETPLACE_STATE_SECRET: OBRIGATÓRIO — sem ele o OAuth do ML retorna 503
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETPLACE_STATE_SECRET=sua-chave-secreta-marketplace-aqui
# URL de redirect após autorização OAuth do Mercado Livre (deve bater com o cadastro do App ML)
MARKETPLACE_REDIRECT_URI=https://lf-erp-backend.onrender.com/marketplace/oauth/callback
# URL base do backend — usada como fallback para MARKETPLACE_REDIRECT_URI
BACKEND_URL=https://lf-erp-backend.onrender.com

# SMTP — Controla verificação TLS ao conectar em servidores SMTP (utils/email.js)
# true ou ausente (padrão): valida certificado TLS — comportamento seguro
# false: desabilita validação TLS — use apenas em desenvolvimento local com SMTP de certificado inválido
SMTP_REJECT_UNAUTHORIZED=true

# Criptografia de credenciais PIX em repouso (utils/pixCrypto.js) — OBRIGATÓRIO em produção
# Sem esta chave, em produção o backend se recusa a iniciar (fail-closed: evita
# armazenar credenciais PIX em texto puro sem ninguém perceber)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure também no Render → Environment → PIX_ENCRYPTION_KEY
PIX_ENCRYPTION_KEY=sua-chave-hex-64-caracteres-aqui

# Proteção de emissão fiscal em produção (utils/focusnfe.js)
# false ou ausente: emissão em ambiente Focus NFe de PRODUÇÃO é BLOQUEADA (retorna 403)
#   → homologação sempre permitida; proteção contra emissão acidental em testes
# true: emissão em produção habilitada — configure somente no servidor de produção real
LF_ERP_FISCAL_PRODUCTION_ENABLED=false
